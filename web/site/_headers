# Cloudflare Pages yanıt başlıkları (biçim: https://developers.cloudflare.com/pages/configuration/headers/)
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Strict-Transport-Security: max-age=31536000; includeSubDomains

# Giriş ve denetim: dış bağlantı yalnız lisans sunucusuna; başka hiçbir adrese veri gönderilemez.
/giris.html
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://rupwlypoblungdfajrya.supabase.co; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Robots-Tag: noindex

/denetim/*
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://rupwlypoblungdfajrya.supabase.co; worker-src 'self'; frame-src 'self' blob: data:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'
  X-Robots-Tag: noindex

/denetim/py/*
  Cache-Control: public, max-age=300
